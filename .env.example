# ---- Copy this file to .env and fill in real values ----

# Anthropic API key used by the RAG augmentation stage
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-5-5

# Redis broker + result backend for Celery workers
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Vector store
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=scraped_docs

# API server
API_HOST=0.0.0.0
API_PORT=8080

# Scraper behaviour
SCRAPER_USER_AGENT=DistributedRAGScraper/1.0
SCRAPER_TIMEOUT=20
SCRAPER_MAX_RETRIES=3
SCRAPER_RATE_LIMIT_SECONDS=1.0
