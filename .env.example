# ---- Copy this file to .env and fill in real values ----

# --- LLM used by the RAG augmentation stage (Task 4) ---
# LLM_PROVIDER=auto   : use Claude when ANTHROPIC_API_KEY is set, otherwise
#                       fall back to the free offline extractive summariser.
# LLM_PROVIDER=extractive : never call a paid API (the zero-cost default path).
# LLM_PROVIDER=anthropic  : always call Claude, and fail loudly without a key.
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5-5
LLM_MAX_TOKENS=1024
LLM_EFFORT=low

# --- RabbitMQ : the dynamic URL frontier ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=scraper
RABBITMQ_PASSWORD=scraper_pass
RABBITMQ_VHOST=/
FRONTIER_EXCHANGE=scraper.frontier
FRONTIER_QUEUE=urls.frontier
FRONTIER_DLQ=urls.dead-letter
# One unacknowledged URL per worker: this is the load-balancing setting.
FRONTIER_PREFETCH=1

# --- PostgreSQL : raw and parsed scraped data ---
# The container is published on host port 5433 because 5432 is often already
# taken by a locally installed PostgreSQL. Inside Docker/Kubernetes use 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper_pass
POSTGRES_DB=scraped_data

# --- MongoDB : the NoSQL store for the cleaned, normalised documents ---
# Published on host port 27018 because 27017 is often already taken by a
# locally installed MongoDB. Inside Docker/Kubernetes use 27017.
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_USER=scraper
MONGO_PASSWORD=scraper_pass
MONGO_DB=processed_data
MONGO_COLLECTION=documents
MONGO_AUTH_SOURCE=admin
MONGO_TIMEOUT_MS=5000

# --- Data processing (Task 3) ---
# Documents written to MongoDB per round trip, and the minimum number of
# clean words a page must yield before it is worth indexing.
PROCESSING_BATCH_SIZE=50
PROCESSING_MIN_WORDS=3

# --- Vector store (Chroma, client/server mode) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=scraped_docs
CHROMA_TIMEOUT=30

# --- RAG : embeddings and retrieval (Task 4) ---
# The embedding model runs locally through ONNX Runtime, so indexing and
# retrieval cost nothing and work offline once the model is cached.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=data/models
EMBEDDING_BATCH_SIZE=32
# Chunking: window and overlap, in words.
CHUNK_WORDS=180
CHUNK_OVERLAP_WORDS=40
CHUNK_MIN_WORDS=20
# Retrieval: chunks kept per query, and candidates pulled from each retriever
# before the two result lists are fused.
RAG_TOP_K=5
RAG_CANDIDATES=20
RAG_INDEX_BATCH_SIZE=128
RAG_CONTEXT_CHARS=6000

# --- Full-text search : Elasticsearch (Task 6) ---
# The search engine behind the web UI: ranked hits, highlighted snippets,
# facet counts and as-you-type suggestions. Security is disabled in the
# development cluster, so the credentials below are empty; a real deployment
# sets both and changes the scheme to https.
ELASTIC_HOST=localhost
ELASTIC_PORT=9200
ELASTIC_SCHEME=http
ELASTIC_USER=
ELASTIC_PASSWORD=
ELASTIC_INDEX=scraped_documents
ELASTIC_TIMEOUT=30
ELASTIC_INDEX_BATCH_SIZE=200
# Characters of page text sent to the index, and the highlighter's snippet
# count and width.
ELASTIC_MAX_TEXT_CHARS=60000
ELASTIC_HIGHLIGHT_FRAGMENTS=3
ELASTIC_HIGHLIGHT_SIZE=180

# --- Frontier backend (Task 7) ---
# rabbitmq : the Task 2 work queue - competing consumers on one queue.
# kafka    : the same frontier on a partitioned log. Work is distributed by
#            assigning partitions to members of a consumer group, so a node
#            can be added or lost without anything being told about it. The
#            Kubernetes manifests use this one.
FRONTIER_BACKEND=rabbitmq

# --- Kafka (dynamic task distribution, Task 7) ---
# Inside Docker the broker is kafka:9092; from the host it is localhost:29092
# (the broker advertises a different address per listener).
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=urls.frontier
KAFKA_DLQ_TOPIC=urls.dead-letter
# Every scraper node joins this group, which is what makes the partitions
# split between them instead of every node receiving every URL.
KAFKA_GROUP_ID=scrapers
# The ceiling on parallelism: a consumer group can never have more working
# members than there are partitions.
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
KAFKA_AUTO_OFFSET_RESET=earliest
# How long the coordinator waits before declaring a silent node dead and
# reassigning its partitions.
KAFKA_SESSION_TIMEOUT_MS=45000
# A consumer that has not polled within this window is removed from the
# group, so one wedged node cannot sit on partitions.
KAFKA_MAX_POLL_INTERVAL_MS=300000
KAFKA_POLL_TIMEOUT=1.0

# --- Worker liveness and metrics (Task 7) ---
# The heartbeat is written when a page is stored, so it tracks progress
# rather than the process existing - which is what lets a Kubernetes
# livenessProbe restart a node that is running but wedged.
WORKER_HEARTBEAT_ENABLED=true
WORKER_HEARTBEAT_MAX_AGE=180
WORKER_METRICS_ENABLED=true
# 9110, not 9100: that one belongs to node_exporter.
WORKER_METRICS_PORT=9110
# Where the heartbeat file goes. The containers set this to a tmpfs or an
# emptyDir, so a heartbeat never outlives the process it describes.
# HEARTBEAT_DIR=data/heartbeats

# --- Redis / Celery (used from Task 4 onwards) ---
REDIS_URL=redis://localhost:6379/0

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8080

# --- Scraper behaviour ---
SCRAPER_USER_AGENT=DistributedRAGScraper/1.0
SCRAPER_TIMEOUT=20
SCRAPER_MAX_RETRIES=3
SCRAPER_RATE_LIMIT_SECONDS=1.0
