# --- Web UI configuration (Task 6) ---

# Where the FastAPI service is. Left empty, requests go to the same origin
# and the Vite dev-server proxy forwards them (see vite.config.ts), which is
# the simplest setup for development. Set it to an absolute URL when the
# built bundle is served from somewhere other than the API.
VITE_API_BASE=

# The API key the UI sends as X-API-Key. It needs the raw, documents, search
# and ask scopes; the development analyst key below has all four.
#
# NOTE: anything in a front-end bundle is public - this is a convenience for
# local use, not a secret store. The key can also be typed into the UI at
# runtime, where it is kept in localStorage instead of being built in.
VITE_API_KEY=dev-analyst-key
